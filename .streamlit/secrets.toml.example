# このファイルを secrets.toml にコピーして値を設定してください（secrets.toml は git 管理外です）。
# formspree_url は https://formspree.io で無料アカウント作成後に発行されるフォームのエンドポイントURLです。
formspree_url = "https://formspree.io/f/YOUR_FORM_ID"

# sentence_generator.py が例文生成に使うAnthropic APIキー。
# https://console.anthropic.com/ で発行し、ここか環境変数 ANTHROPIC_API_KEY に設定してください。
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxx"
